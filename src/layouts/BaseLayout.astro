---
import SiteHeader from "../components/layout/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nūr — Build the person you want to become",
  description = "Protect your attention. Strengthen self-control. Recover, rebuild and grow."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#03140F" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div class="footer-brand-block">
            <a class="footer-brand" href="/" aria-label="Nūr home">nūr<span>.</span></a>
            <p>Build the person you want to become.</p>
            <small>Self-control. Protection. Recovery. Growth.</small>
          </div>
          <nav class="footer-group" aria-label="Explore Nūr">
            <h2>Explore</h2>
            <a href="/how-it-works/">How Nūr works</a>
            <a href="/#features">Features</a>
            <a href="/#about">About Nūr</a>
          </nav>
          <nav class="footer-group" aria-label="Trust and information">
            <h2>Trust</h2>
            <a href="/#privacy">Privacy &amp; Trust</a>
            <a href="/#limits">What Nūr cannot do</a>
            <a href="/#faq">Frequently asked questions</a>
          </nav>
          <div class="footer-group footer-status">
            <h2>Availability</h2>
            <span class="footer-status-label"><i aria-hidden="true"></i> In development</span>
            <a href="/#alpha-status">Closed-alpha status</a>
          </div>
        </div>
        <div class="footer-bottom">
          <small>© {new Date().getFullYear()} Nūr. Built for intentional growth.</small>
          <a href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    padding: 3.5rem 0 1.4rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(130px, .7fr));
    gap: 2rem;
    padding-bottom: 2.8rem;
  }
  .footer-brand-block { max-width: 270px; }
  .footer-brand {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 2.15rem;
    letter-spacing: -.08em;
    text-decoration: none;
  }
  .footer-brand span { color: var(--color-accent); }
  .footer-brand-block p { margin: .8rem 0 .35rem; color: var(--color-text); font-size: .9rem; }
  .footer-brand-block small, .footer-bottom small { color: var(--color-text-muted); font-size: .72rem; line-height: 1.6; }
  .footer-group { display: flex; flex-direction: column; align-items: flex-start; gap: .7rem; }
  .footer-group h2 { margin: .25rem 0 .35rem; color: var(--color-text); font-size: .78rem; font-weight: 700; }
  .footer-group a { color: var(--color-text-muted); font-size: .78rem; line-height: 1.5; text-decoration: none; }
  .footer-group a:hover, .footer-bottom a:hover { color: var(--color-accent); }
  .footer-status-label { display: inline-flex; align-items: center; gap: .5rem; color: var(--color-text-muted); font-size: .76rem; }
  .footer-status-label i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--color-accent); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
  .footer-bottom a { color: var(--color-text-muted); font-size: .75rem; text-decoration: none; }
  @media (max-width: 760px) {
    .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
    .footer-brand-block { grid-column: 1 / -1; }
  }
  @media (max-width: 420px) {
    .footer-main { grid-template-columns: 1fr 1fr; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
