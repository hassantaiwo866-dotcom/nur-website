---
import BaseLayout from "../layouts/BaseLayout.astro";

const stages = [
  { number: "01", name: "PROTECT", title: "Create healthier boundaries", body: "Reduce exposure to things that pull you away from your intentions. Protection can create a better starting point, but no tool can remove every distraction or make choices for you.", question: "What boundary would make the next choice easier?" },
  { number: "02", name: "RESIST", title: "Make room for a different choice", body: "Notice a difficult moment and create space before acting. The aim is not to pretend urges never happen; it is to give yourself a little more room to choose what happens next.", question: "Can you pause long enough to choose your next step?" },
  { number: "03", name: "RECOVER", title: "Return without shame", body: "When a plan breaks or a setback happens, start from where you are. Consider one helpful next step. A difficult moment does not erase your effort or define your worth.", question: "What would a constructive next step look like now?" },
  { number: "04", name: "REBUILD", title: "Strengthen better patterns", body: "Build routines through manageable actions. Consistency can take time, and progress may look different from one person to another. Nūr cannot guarantee an outcome or form a habit for you.", question: "What small action is realistic today?" },
  { number: "05", name: "LIVE", title: "Put attention back into life", body: "The goal is not to spend more time inside an app. It is to make more room for relationships, responsibilities, creativity, rest, faith where relevant and meaningful activities beyond a screen.", question: "What deserves more of your attention?" },
  { number: "06", name: "LEARN", title: "Understand what helps", body: "Reflect on your experience and notice what supports you. Use information only where the product actually provides it; your life is not a scorecard and no single metric tells the whole story.", question: "What have you noticed about what helps?" },
  { number: "07", name: "ADAPT", title: "Adjust your approach", body: "Your circumstances can change. Review your boundaries and goals, then adjust them in a way that makes sense for you. You remain in control of your direction and next steps.", question: "What needs to change to support you now?" }
];
---
<BaseLayout
  title="How Nūr Works — A process for intentional growth"
  description="Explore Nūr's guiding approach to protection, self-control, recovery, rebuilding and intentional living. A repeatable framework, not a perfection scorecard."
>
  <section class="works-hero section">
    <div class="container works-hero-inner">
      <a class="back-link" href="/">← Back to Nūr</a>
      <p class="eyebrow">HOW NŪR WORKS</p>
      <h1 class="display-heading">Change is a process.<br /><span>You can return to it.</span></h1>
      <p class="works-lead">Nūr is being built around a simple idea: protecting your attention is only one part of growth. What matters is what you choose, how you recover, and how you build a life beyond the screen.</p>
      <a class="works-cta" href="/#alpha-status">View closed-alpha status <span aria-hidden="true">↗</span></a>
      <div class="cycle-visual" aria-label="The Nūr approach: Protect, Resist, Recover, Rebuild, Live, Learn and Adapt. The cycle can be revisited at any stage.">
        <div class="cycle-ring" aria-hidden="true"></div>
        <div class="cycle-centre"><span>THE NŪR</span><strong>Approach</strong><small>RETURN · REFLECT · ADJUST</small></div>
        <span class="cycle-node node-one">PROTECT</span>
        <span class="cycle-node node-two">RESIST</span>
        <span class="cycle-node node-three">RECOVER</span>
        <span class="cycle-node node-four">REBUILD</span>
        <span class="cycle-node node-five">LIVE</span>
        <span class="cycle-node node-six">LEARN</span>
        <span class="cycle-node node-seven">ADAPT</span>
      </div>
      <p class="cycle-caption">Not a ladder. Not a streak. A process you can return to.</p>
    </div>
  </section>

  <section class="works-stages section" aria-labelledby="stages-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">SEVEN PARTS, ONE HUMAN JOURNEY</p>
        <h2 id="stages-title" class="display-heading">A little more room<br /><span>for what matters.</span></h2>
        <p>Each part supports a different kind of decision. You do not have to complete them in order, and you do not lose your progress when life gets difficult.</p>
      </header>
      <div class="stage-list">
        {stages.map((stage) => (
          <article class="stage-detail" id={stage.name.toLowerCase()}>
            <div class="stage-marker"><span>{stage.number}</span><i aria-hidden="true"></i></div>
            <div class="stage-content">
              <p class="eyebrow">{stage.name}</p>
              <h3>{stage.title}</h3>
              <p class="stage-body">{stage.body}</p>
              <p class="stage-question">{stage.question}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="works-realism section" aria-labelledby="realism-title">
    <div class="container realism-panel">
      <p class="eyebrow">A FRAMEWORK, NOT A PROMISE</p>
      <h2 id="realism-title" class="display-heading">Nūr supports the process.<br /><span>You remain the person living it.</span></h2>
      <div class="realism-grid">
        <article><h3>What this is</h3><p>A product philosophy that connects protection, intentional choices, recovery and growth.</p></article>
        <article><h3>What this is not</h3><p>A guaranteed transformation, a medical treatment, a religious authority or a requirement to use every feature.</p></article>
        <article><h3>What exists today</h3><p>Some app foundations and tools have been implemented. Others remain in development, testing or planning. Availability and limitations will be stated clearly.</p></article>
      </div>
      <p class="realism-note">Islamic Mode is optional. Nūr is designed for a broad audience and does not measure a person's faith or issue religious rulings.</p>
    </div>
  </section>

  <section class="works-next section">
    <div class="container next-panel">
      <div><p class="eyebrow">KEEP EXPLORING</p><h2>Understand the tools behind the approach.</h2><p>See the features Nūr is being built around, including their current limitations.</p></div>
      <a href="/#features">Explore Nūr's features <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .works-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--color-border); background: radial-gradient(ellipse at 50% 42%, rgb(40 130 83 / 17%), transparent 55%), var(--color-bg); }
  .works-hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .back-link { align-self: flex-start; margin-bottom: 3rem; color: var(--color-text-muted); font-size: .8rem; text-decoration: none; }
  .back-link:hover { color: var(--color-accent); }
  .works-hero h1 { margin: 1rem 0; font-size: clamp(2.8rem, 7vw, 5.7rem); }
  .works-hero h1 span, .section-heading h2 span, .realism-panel h2 span { color: var(--color-accent); }
  .works-lead { max-width: 690px; color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.8; }
  .works-cta, .next-panel > a { display: inline-flex; align-items: center; gap: .6rem; margin-top: 1rem; color: var(--color-accent); font-size: .88rem; font-weight: 700; text-decoration: none; }
  .works-cta:hover, .next-panel > a:hover { text-decoration: underline; text-underline-offset: .25rem; }
  .cycle-visual { position: relative; display: grid; width: min(100%, 560px); aspect-ratio: 1.65 / 1; place-items: center; margin: 3rem auto 0; }
  .cycle-ring { position: absolute; width: 66%; aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--color-accent) 48%, transparent); border-radius: 50%; box-shadow: 0 0 70px rgb(101 217 160 / 9%), inset 0 0 55px rgb(101 217 160 / 5%); }
  .cycle-ring::before, .cycle-ring::after { position: absolute; inset: 10%; border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent); border-radius: 50%; content: ""; }
  .cycle-ring::after { inset: 22%; border-color: color-mix(in srgb, var(--color-accent) 18%, transparent); }
  .cycle-centre { z-index: 1; display: flex; width: 142px; aspect-ratio: 1; flex-direction: column; align-items: center; justify-content: center; gap: .2rem; border: 1px solid var(--color-border); border-radius: 50%; background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .cycle-centre span, .cycle-centre small { color: var(--color-text-muted); font-size: .55rem; font-weight: 700; letter-spacing: .13em; }
  .cycle-centre strong { color: var(--color-text); font-family: var(--font-display); font-size: 1.55rem; font-weight: 400; }
  .cycle-centre small { margin-top: .35rem; font-size: .43rem; }
  .cycle-node { position: absolute; z-index: 2; padding: .6rem .85rem; border: 1px solid var(--color-border); border-radius: 99px; background: var(--color-surface); color: var(--color-accent); font-size: .62rem; font-weight: 700; letter-spacing: .12em; box-shadow: var(--shadow-soft); }
  .node-one { top: 5%; left: 39%; } .node-two { top: 23%; right: 1%; } .node-three { bottom: 22%; right: 2%; } .node-four { bottom: 3%; left: 38%; } .node-five { bottom: 22%; left: 1%; } .node-six { top: 23%; left: 1%; } .node-seven { top: 1%; right: 16%; }
  .cycle-caption { margin: 0; color: var(--color-text-muted); font-size: .75rem; }
  .works-stages { border-bottom: 1px solid var(--color-border); }
  .section-heading { max-width: 700px; margin: 0 auto 3rem; text-align: center; }
  .section-heading h2 { margin: .8rem 0; font-size: clamp(2.4rem, 5vw, 4.3rem); }
  .section-heading > p:last-child { color: var(--color-text-muted); line-height: 1.8; }
  .stage-list { max-width: 850px; margin: 0 auto; }
  .stage-detail { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1.5rem; padding: 2rem 0; border-top: 1px solid var(--color-border); scroll-margin-top: 2rem; }
  .stage-marker { display: flex; flex-direction: column; align-items: center; gap: .7rem; }
  .stage-marker span { color: var(--color-accent); font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
  .stage-marker i { width: 1px; flex: 1; min-height: 3rem; background: linear-gradient(var(--color-accent), transparent); }
  .stage-content .eyebrow { margin: 0 0 .6rem; }
  .stage-content h3 { margin: 0 0 .8rem; font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.25rem); font-weight: 400; }
  .stage-body { max-width: 680px; color: var(--color-text-muted); font-size: .92rem; line-height: 1.8; }
  .stage-question { display: inline-block; margin: .4rem 0 0; padding: .65rem .9rem; border-left: 2px solid var(--color-accent); background: var(--color-surface); color: var(--color-text); font-size: .82rem; line-height: 1.6; }
  .works-realism { background: var(--color-bg); }
  .realism-panel { padding: clamp(1.5rem, 5vw, 3.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: radial-gradient(ellipse at 12% 0%, rgb(101 217 160 / 9%), transparent 50%), var(--color-surface); }
  .realism-panel h2 { max-width: 760px; margin: .8rem 0 2rem; font-size: clamp(2.2rem, 4.5vw, 3.8rem); }
  .realism-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .realism-grid article { padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .realism-grid h3 { margin: .3rem 0 .6rem; font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; }
  .realism-grid p, .realism-note { color: var(--color-text-muted); font-size: .84rem; line-height: 1.75; }
  .realism-note { margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .works-next { border-top: 1px solid var(--color-border); }
  .next-panel { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.4rem, 4vw, 2.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); }
  .next-panel h2 { margin: .6rem 0; font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 400; }
  .next-panel p:not(.eyebrow) { margin: 0; color: var(--color-text-muted); font-size: .85rem; line-height: 1.7; }
  .next-panel > a { flex-shrink: 0; margin: 0; }
  @media (max-width: 760px) {
    .back-link { margin-bottom: 2rem; }
    .cycle-visual { width: min(100%, 440px); aspect-ratio: 1.25 / 1; margin-top: 2rem; }
    .cycle-ring { width: 62%; }
    .cycle-centre { width: 112px; }
    .cycle-centre strong { font-size: 1.3rem; }
    .cycle-node { padding: .48rem .58rem; font-size: .52rem; }
    .node-one { top: 5%; left: 34%; } .node-two { top: 24%; right: 0; } .node-three { bottom: 20%; right: 0; } .node-four { bottom: 3%; left: 33%; } .node-five { bottom: 20%; left: 0; } .node-six { top: 24%; left: 0; } .node-seven { top: 0; right: 11%; }
    .realism-grid { grid-template-columns: 1fr; gap: 1rem; }
    .next-panel { align-items: flex-start; flex-direction: column; gap: .8rem; }
  }
  @media (max-width: 390px) {
    .cycle-visual { width: 108%; margin-inline: -4%; }
    .cycle-node { padding: .4rem .45rem; font-size: .46rem; }
    .cycle-centre { width: 96px; }
  }
  @media (prefers-reduced-motion: reduce) { .works-cta, .next-panel > a { transition: none; } }
</style>
