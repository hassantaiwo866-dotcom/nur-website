---
const questions = [
  {
    id: "what-is-nur",
    question: "What is Nūr?",
    answer: "Nūr is being built as a self-control, protection, recovery and personal-growth app. It brings together tools intended to help you protect your attention, make more intentional choices, recover without shame and build habits that matter to you. It is more than a website blocker."
  },
  {
    id: "block-everything",
    question: "Can Nūr block every explicit website or app?",
    answer: "No. Protection depends on your device, operating system, browser, network and supported traffic. The current Android protection foundation is not a full-device content firewall, and it cannot guarantee that every explicit website, app or bypass route will be blocked. Reliability and device behaviour still require testing."
  },
  {
    id: "data-storage",
    question: "Where is my Nūr data stored?",
    answer: "Some preferences and activity records are stored locally on your device. Features that use online services may process or store specific information remotely. The exact storage location depends on the feature. See the Privacy & Trust section for the current explanation and its limitations."
  },
  {
    id: "accountability-history",
    question: "Does Nūr send my browsing history to an accountability partner?",
    answer: "Nūr's intended approach is deliberate, limited sharing—not unrestricted access to browsing history or private conversations. The complete two-device workflow and remote access controls have not yet been verified as production-ready. Do not rely on the accountability feature until its release status is confirmed."
  },
  {
    id: "islamic-mode",
    question: "Is Nūr only for Muslims?",
    answer: "No. Nūr is intended for a broad audience. Islamic Mode is optional and is not required to use the core app. Nūr does not issue fatwas or replace qualified religious guidance."
  },
  {
    id: "availability",
    question: "Is Nūr available to download now?",
    answer: "Nūr is still being developed. Download and closed-alpha access details will be published when they are confirmed. This website does not currently offer an active registration form, and we will not announce an unconfirmed release date."
  }
];
---
<section id="faq" class="faq-section section" aria-labelledby="faq-title">
  <div class="container">
    <div class="faq-layout">
      <header class="faq-intro">
        <p class="eyebrow">GOOD QUESTIONS. CLEAR ANSWERS.</p>
        <h2 id="faq-title" class="display-heading">Before you begin.</h2>
        <p>A few practical answers about what Nūr does, how it handles information, and what it is still learning to do.</p>
        <a class="faq-more" href="#privacy">Read about privacy & trust <span aria-hidden="true">↗</span></a>
      </header>
      <div class="faq-list">
        {questions.map((item, index) => (
          <details class="faq-item">
            <summary>
              <span class="faq-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="faq-question">{item.question}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
    <p class="faq-note">Answers describe the current development position and intended product boundaries. Feature availability may change; check the release information before relying on a capability.</p>
  </div>
</section>

<style>
  .faq-section { border-top: 1px solid var(--color-border); background: var(--color-bg); }
  .faq-layout { display: grid; grid-template-columns: minmax(230px, .72fr) minmax(0, 1.28fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .faq-intro { position: sticky; top: 2rem; max-width: 430px; }
  .faq-intro h2 { margin: 1rem 0 .9rem; font-size: clamp(2.6rem, 5vw, 4rem); }
  .faq-intro > p:not(.eyebrow) { color: var(--color-text-muted); font-size: .95rem; line-height: 1.75; }
  .faq-more { display: inline-flex; gap: .5rem; margin-top: 1rem; color: var(--color-accent); font-size: .85rem; font-weight: 700; text-decoration: none; }
  .faq-more:hover { text-decoration: underline; text-underline-offset: .25rem; }
  .faq-list { border-top: 1px solid var(--color-border); }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item summary { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 1.5rem; align-items: center; gap: .8rem; min-height: 5rem; padding: 1rem .2rem; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-index { color: var(--color-accent); font-size: .68rem; font-weight: 700; letter-spacing: .1em; }
  .faq-question { color: var(--color-text); font-family: var(--font-display); font-size: clamp(1.08rem, 2vw, 1.3rem); line-height: 1.35; }
  .faq-toggle { position: relative; width: 1.35rem; aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: 50%; }
  .faq-toggle::before, .faq-toggle::after { position: absolute; top: 50%; left: 50%; width: .5rem; height: 1px; background: var(--color-text); content: ""; transform: translate(-50%, -50%); }
  .faq-toggle::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 160ms ease; }
  .faq-item[open] .faq-toggle::after { transform: translate(-50%, -50%) rotate(0); }
  .faq-item summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: .35rem; }
  .faq-answer { padding: 0 2.4rem 1.4rem 2.8rem; }
  .faq-answer p { max-width: 680px; margin: 0; color: var(--color-text-muted); font-size: .88rem; line-height: 1.8; }
  .faq-note { max-width: 850px; margin: 2rem 0 0; color: var(--color-text-muted); font-size: .75rem; line-height: 1.65; }
  @media (max-width: 760px) {
    .faq-layout { grid-template-columns: 1fr; gap: 2rem; }
    .faq-intro { position: static; }
    .faq-item summary { min-height: 4.5rem; grid-template-columns: 1.6rem minmax(0, 1fr) 1.35rem; gap: .55rem; }
    .faq-answer { padding-left: 2.15rem; padding-right: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-toggle::after { transition: none; }
  }
</style>
